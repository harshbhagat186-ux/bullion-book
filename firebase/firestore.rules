rules_version = '2';
// Bullion Book security rules ("firewall").
// Only the OWNER account (by user id) and the emails listed in shops/main/meta/access.emails can read or write.
// Everyone else, signed in or not, is blocked. Replace OWNER_UID below with the owner's Firebase user id.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == 'DDk0a0fy5bWa0P52MAAGC1CUc4u2';
    }
    function staff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/shops/main/meta/access)
        && request.auth.token.email in get(/databases/$(database)/documents/shops/main/meta/access).data.emails;
    }
    function allowed() { return owner() || staff(); }

    // who may use the shop: only the owner can change this list
    match /shops/main/meta/access {
      allow read: if allowed();
      allow write: if owner();
    }
    // shop settings, opening stock, bill numbers
    match /shops/main/meta/state {
      allow read, write: if allowed();
    }
    // bills, entries, parties, sauda
    match /shops/main/records/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.k in ['bill', 'entry', 'party', 'sauda']
        && request.resource.data.by == request.auth.token.email;
      allow delete: if allowed();
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
